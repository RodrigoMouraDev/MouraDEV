# Copie para .env (local) e cadastre as mesmas variáveis no EAS:
#   eas env:create --environment preview --name EXPO_PUBLIC_AZURE_TENANT_ID --value <valor> --visibility plaintext
# Variáveis EXPO_PUBLIC_* são embutidas no app (não são segredos). Não há client secret: app público + PKCE.

# Microsoft Entra ID (Azure AD) — App registration
EXPO_PUBLIC_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# SharePoint Online
EXPO_PUBLIC_SP_HOSTNAME=arauco.sharepoint.com
EXPO_PUBLIC_SP_SITE_PATH=/sites/ProjetoSucuriu
EXPO_PUBLIC_SP_LIST_NAME=PunchList
EXPO_PUBLIC_SP_LIBRARY_NAME=Documentos
EXPO_PUBLIC_SP_PHOTO_FOLDER=PunchList/Fotos
EXPO_PUBLIC_SP_MASTER_PATH=PunchList/Modelo - Punch list.xlsx
