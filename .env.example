# Copie para .env (local) e cadastre as mesmas variáveis no EAS:
#   eas env:create --environment preview --name EXPO_PUBLIC_AZURE_TENANT_ID --value <valor> --visibility plaintext
# Variáveis EXPO_PUBLIC_* são embutidas no app (não são segredos). Não há client secret: app público + PKCE.

# Microsoft Entra ID do tenant Timenow (dono do SharePoint) — App registration
EXPO_PUBLIC_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# SharePoint Online — opcionais: os valores abaixo já são o padrão do app (site AraucoProjetoSucuriu, Timenow)
# EXPO_PUBLIC_SP_HOSTNAME=timenow.sharepoint.com
# EXPO_PUBLIC_SP_SITE_PATH=/sites/AraucoProjetoSucuriu
# EXPO_PUBLIC_SP_LIST_NAME=PunchList
# EXPO_PUBLIC_SP_LIBRARY_NAME=01 Documentao
# EXPO_PUBLIC_SP_PHOTO_FOLDER=GERENCIAMENTO DE EPC/05- Qualidade/QUALIDADE - SUCURIU/07 - GESTÃO E CONTROLE/10-PUNCH LIST/FOTOS
# EXPO_PUBLIC_SP_MASTER_PATH=GERENCIAMENTO DE EPC/05- Qualidade/QUALIDADE - SUCURIU/07 - GESTÃO E CONTROLE/10-PUNCH LIST/BASE DE DADOS/Modelo - Punch list.xlsx
