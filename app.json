{
  "expo": {
    "name": "Punch List Sucuriú",
    "slug": "punchlist-sucuriu",
    "scheme": "punchlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.arauco.sucuriu.punchlist",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para fotografar as pendências da Punch List em campo.",
        "NSPhotoLibraryUsageDescription": "A galeria é usada para anexar fotos às pendências da Punch List.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arauco.sucuriu.punchlist",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#00594C"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmera é usada para fotografar as pendências da Punch List em campo.",
          "photosPermission": "A galeria é usada para anexar fotos às pendências da Punch List.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8749ae33-f665-492c-acfd-4fda6c55fba5"
      }
    },
    "owner": "mouradevultra",
    "icon": "./assets/icon.png",
    "web": {
      "name": "Punch List Sucuriú",
      "shortName": "Punch List",
      "themeColor": "#00594C",
      "backgroundColor": "#F4F6F5",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "lang": "pt-BR"
    }
  }
}
